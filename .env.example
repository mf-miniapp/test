# OpenSquilla API Keys
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required — LLM provider (OpenRouter)
OPENROUTER_API_KEY=

# Optional — Brave Search API (auto-selected over DuckDuckGo when set)
# Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Optional — Web search network proxy.
# Use this when Brave/DuckDuckGo endpoints are not reachable directly.
# This affects web_search only; LLM provider proxy is configured separately.
OPENSQUILLA_GATEWAY_SEARCH_PROXY=

# Optional — allow web_search providers to use HTTP_PROXY/HTTPS_PROXY when no
# explicit search proxy is set. Defaults to false for predictable behavior.
OPENSQUILLA_GATEWAY_SEARCH_USE_ENV_PROXY=false

# ── AssetTree (asset_tree_*) DB ─────────────────────────────────────────
# Required for any `asset_tree_*` tool (asset_tree_create, asset_tree_add_nodes,
# asset_tree_update_state, asset_tree_find_unseen, asset_tree_get_subtree,
# asset_tree_list_siblings, asset_tree_stats, asset_tree_complete,
# asset_tree_merge). Without this, asset_tree_create fails with
# `AssetTreeConfigError: ASSET_TREE_DB_URL is not set ...` and the
# `hack-deep-find` orchestrator falls back to `recon_*` tools only.
#
# Only MySQL is supported by the AssetTree backend.
#
# Local dev (Docker) quick start:
#   docker run -d --name opensquilla-mysql \
#     -e MYSQL_ROOT_PASSWORD=opensquilla \
#     -e MYSQL_DATABASE=opensquilla \
#     -e MYSQL_USER=opensquilla \
#     -e MYSQL_PASSWORD=opensquilla \
#     -p 127.0.0.1:3307:3306 \
#     public.ecr.aws/docker/library/mysql:8.0
#
#   pip install aiomysql   # required driver (already in pyproject deps)
#
# If host port 3306 is already taken, map the host to a free port (e.g. 3307)
# and put that host port into the URL below.
ASSET_TREE_DB_URL=mysql+aiomysql://opensquilla:opensquilla@127.0.0.1:3307/opensquilla

# ── MiniMax (MiniMax-M3) ──────────────────────────────────────────────
# Required for the c3 (highest) tier. The router resolves this via
# `api_key_env = "MINIMAX_API_KEY"` on the tier block, so the key
# itself never needs to be inlined in config.toml.
#
# Get a key at https://api.minimaxi.com/  (MiniMax / MiniMax-M3 / MiniMax-M2.x family)
#
# Local dev (no MySQL needed for this one — it's API-only):
#   1. cp .env.example ~/.opensquilla/.env
#   2. fill in the key below
#   3. add a [squilla_router.tiers.c3] block in ~/.opensquilla/config.toml:
#
#      [squilla_router.tiers.c3]
#      provider = "minimax_openai"
#      model = "MiniMax-M3"
#      base_url = "https://api.minimaxi.com/v1"
#      api_key_env = "MINIMAX_API_KEY"
#
#   4. sh restart.sh
MINIMAX_API_KEY=
